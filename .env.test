HTTPS=on
# Deterministic dummy for the test kernel (Symfony skips .env.local in test).
APP_SECRET=test-secret-not-used-in-production
HTTP_REDUCTION=false
HTTP_DOMAIN='["localhost"]'
HTTP_SUBDOMAIN='[]'
HTTP_MACHINE='[]'
HTTP_BASEDIR=/
HTTP_PORT='[80,8124]'
HTTPS_PORT='[443,8633]'

MAILER_LOOPBACK=true
MAILER_DSN=null://null
MESSENGER_TRANSPORT_DSN=sync://
USE_SYS_TMPDIR=false
