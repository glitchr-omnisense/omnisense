HTTPS=on
HTTP_REDUCTION=true
HTTP_DOMAIN='["omnisense.local", "localhost"]'
HTTP_SUBDOMAIN='["", "www"]'
HTTP_MACHINE='[""]'
HTTP_BASEDIR=/
HTTP_PORT='[80,8124]'
HTTPS_PORT='[443,8633]'

# Every mail goes to the technical recipient, then to MailDev
# (https://<host>/admin/_/mailer/).
MAILER_LOOPBACK=true
MAILER_DSN=smtp://mailer:1025
MAILER_TECHNICAL=support@glitchr.io

USE_SYS_TMPDIR=false
