{
    "name": "omniscient/omniscient",
    "description": "Omniscient: the Omni ecosystem's website - guides, news, the package catalogue and each package's documentation, built statically by omnibridge/static",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "_comment": "Direct VCS sources on GitHub (glitchr-studio): a *-dev constraint resolved through Packagist can pin a stale commit. no-api: plain git, no GitHub API quota.",
            "type": "vcs",
            "url": "https://github.com/glitchr-studio/omnibase.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/glitchr-studio/well-known.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/glitchr-studio/backup-manager.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/glitchr-studio/symfony-profiler-pack.git",
            "no-api": true
        }
    ],
    "require": {
        "ext-ctype": "*",
        "ext-iconv": "*",
        "php": ">=8.2",
        "phpdocumentor/reflection-docblock": "^5.3",
        "phpoffice/phpspreadsheet": "^1.23|^2.0",
        "phpstan/phpdoc-parser": "^1.23",
        "api-platform/doctrine-orm": "^4.0",
        "api-platform/symfony": "^4.0",
        "doctrine/collections": "^3.1",
        "doctrine/doctrine-bundle": "^3.2.4",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "glitchr/backup-manager": "4.0.*-dev",
        "glitchr/well-known": "1.0.*-dev",
        "guzzlehttp/guzzle": "^7.4",
        "hwi/oauth-bundle": "^2.1",
        "jaybizzle/crawler-detect": "^1.2",
        "league/commonmark": "^2.7",
        "league/flysystem-async-aws-s3": "*",
        "league/flysystem-bundle": "^3.1",
        "league/flysystem-ftp": "^3.1",
        "nelmio/cors-bundle": "^2.3",
        "nelmio/security-bundle": "^3.0",
        "omnibridge/composer": "1.x-dev",
        "omnibridge/doctrine": "1.x-dev",
        "omnibridge/static": "1.x-dev",
        "omnibridge/symfony": "1.x-dev",
        "omnibridge/twig": "1.x-dev",
        "omniscient/omnibase": "4.x-dev as 4.0.x-dev",
        "omniscient/omnibridge": "1.x-dev",
        "omniscient/omnidrive": "1.x-dev",
        "scheb/2fa": "^7.0|^8.0",
        "symfony/apache-pack": "^1.0",
        "symfony/asset": "^8.0",
        "symfony/cache": "^8.0",
        "symfony/config": "^8.0",
        "symfony/console": "^8.0",
        "symfony/css-selector": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/doctrine-bridge": "^8.0",
        "symfony/doctrine-messenger": "^8.0",
        "symfony/dotenv": "^8.0",
        "symfony/expression-language": "^8.0",
        "symfony/filesystem": "^8.0",
        "symfony/flex": "^2.0",
        "symfony/form": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/http-foundation": "^8.0",
        "symfony/intl": "^8.0",
        "symfony/lock": "^8.0",
        "symfony/mailer": "^8.0",
        "symfony/messenger": "^8.0",
        "symfony/monolog-bundle": "^3.1|^4.0",
        "symfony/notifier": "^8.0",
        "symfony/process": "^8.0",
        "symfony/property-access": "^8.0",
        "symfony/property-info": "^8.0",
        "symfony/rate-limiter": "^8.0",
        "symfony/redis-messenger": "^8.1",
        "symfony/runtime": "^8.0",
        "symfony/security-bundle": "^8.0",
        "symfony/serializer": "^8.0",
        "symfony/stimulus-bundle": "^2.0",
        "symfony/string": "^8.0",
        "symfony/translation": "^8.0",
        "symfony/twig-bundle": "^8.0",
        "symfony/type-info": "^8.0",
        "symfony/ux-twig-component": "^2.0|^3.0",
        "symfony/validator": "^8.0",
        "symfony/web-link": "^8.0",
        "symfony/webpack-encore-bundle": "^2.1",
        "symfony/yaml": "^8.0",
        "tempest/highlight": "^2.0",
        "twig/extra-bundle": "^2.12|^3.0",
        "twig/twig": "^3.4",
        "web-auth/webauthn-symfony-bundle": "*"
    },
    "require-dev": {
        "composer/composer": "*",
        "doctrine/doctrine-fixtures-bundle": "^3.4|^4.0",
        "friendsofphp/php-cs-fixer": "^3.13",
        "glitchr/symfony-profiler-pack": "1.x-dev",
        "phpunit/phpunit": "^12.0",
        "symfony/browser-kit": "^8.0",
        "symfony/debug-bundle": "^8.0",
        "symfony/maker-bundle": "^1.60",
        "symfony/phpunit-bridge": "^8.0",
        "symfony/stopwatch": "^8.0",
        "symfony/var-dumper": "^8.0",
        "symfony/web-profiler-bundle": "^8.0"
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "php-http/discovery": true,
            "omnibridge/composer": true
        },
        "platform": {
            "ext-amqp": "2.2.0",
            "ext-bcmath": "8.4.22",
            "ext-curl": "8.4.22",
            "ext-dom": "20031129",
            "ext-gd": "8.4.22",
            "ext-igbinary": "3.2.17",
            "ext-imagick": "3.8.1",
            "ext-intl": "8.4.22",
            "ext-mbstring": "8.4.22",
            "ext-mysqlnd": "1.0.0",
            "ext-pdo_mysql": "8.4.22",
            "ext-pdo_sqlite": "8.4.22",
            "ext-redis": "6.3.0",
            "ext-simplexml": "8.4.22",
            "ext-sqlite3": "8.4.22",
            "ext-xml": "8.4.22",
            "ext-xmlreader": "8.4.22",
            "ext-xmlwriter": "8.4.22",
            "ext-xsl": "8.4.22",
            "ext-zip": "1.22.8",
            "php": "8.4.22"
        },
        "optimize-autoloader": true,
        "minimum-stability": "dev",
        "prefer-stable": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "exclude-from-classmap": [
            "vendor/omniscient/omnibase/src/Admin/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
        "auto-scripts": {
            "assets:install --symlink --relative %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": "true",
            "require": "8.1.*"
        }
    }
}
