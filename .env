# Safe defaults only — no real credentials in this file (it is committed).
# Machine-specific values (APP_NAME, APP_PATH, APP_ENV, APP_DEBUG, APP_SECRET,
# passwords, pinned ports) belong in the gitignored .env.local; `make env`
# (run by `make up`) writes the first four there.
#
# APP_NAME is NOT defined here: `make env` writes it to .env.local. Nothing
# below depends on it: the hosts are the compose service names (database,
# cache, queue...), the same whatever the project is called, so `make up` and
# a bare `docker compose up` give the same containers. The compose files fall
# back to the project name (this directory) for APP_NAME, and the ports below
# are this app's dev ports, pinned (.env.local may still override them).

###> mysql ###
MYSQL_HOST=database
MYSQL_DATABASE=omniscient
MYSQL_USER=omniscient
# Override with real passwords per machine in .env.local
MYSQL_PASSWORD=omniscient
MYSQL_ROOT_PASSWORD=omniscient-root
###< mysql ###

###> redis ###
REDIS_HOST=cache
REDIS_PORT=6379
QUEUE_HOST=queue
###< redis ###

###> doctrine/doctrine-bundle ###
DOCTRINE_DATABASE_HOST=${MYSQL_HOST}
DOCTRINE_DATABASE_PORT=3306
DOCTRINE_DATABASE_USER=${MYSQL_USER}
DOCTRINE_DATABASE_PASSWORD=${MYSQL_PASSWORD}
DOCTRINE_DATABASE=${MYSQL_DATABASE}
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# The queue container (docker-compose.yml). Drained by the worker service.
MESSENGER_TRANSPORT_DSN=sync://
###< symfony/messenger ###

###> symfony/framework-bundle ###
# APP_SECRET is NOT set here: prod reads it from the secrets vault, dev
# machines set it in .env.local (php -r "echo bin2hex(random_bytes(32));").
###< symfony/framework-bundle ###

###> symfony/mailer ###
MAILER_DSN=smtp://mailer:1025
MAILER_LOOPBACK=true
# Sender, and the loopback's one recipient (base.yaml: technical_recipient).
MAILER_TECHNICAL=noreply@omnisense.local
# Where the contact form goes.
MAILER_CONTACT=contact@omnisense.local
###< symfony/mailer ###

###> anti-spam ###
# Akismet (omnibase's SpamChecker). Typed in the back office (API keys) it
# wins over this value. reCAPTCHA v3 stays off (config/packages/google.yaml).
AKISMET_KEY=
GOOGLE_RECAPTCHA_SITE_KEY=
GOOGLE_RECAPTCHA_SECRET=
###< anti-spam ###

PHP_TIMEZONE=Europe/Paris
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_MAX_FILESIZE=64M
PHP_POST_MAX_SIZE=64M
PHP_MAX_EXECUTION_TIME=120
PHP_OPCACHE=1
# PHP sessions live in the cache container (deployments/docker/web/php.ini).
PHP_REDIS_URL="${REDIS_HOST}:${REDIS_PORT}"
CORS_ALLOW_ORIGIN="*"

SYMFONY_PROCESS_TIMEOUT=${PHP_MAX_EXECUTION_TIME}

YARN_CACHE_FOLDER=/tmp/yarn-cache
XDG_CACHE_HOME=/tmp/.cache
COREPACK_HOME=/tmp/corepack

APP_REPLICAS=1

# Asset build mode, decoupled from APP_ENV (deployments/docker/assets/entrypoint.sh).
#ASSETS_ENV=prod

APP_PATH=
APP_DEBUG=1
APP_ENV=dev

# Published proxy ports, this app's on the dev machine (plan 0 §2: Omnisense
# 8124/8633). .env.local may still override them.
APP_HTTP=8124
APP_HTTPS=8633

# Names baked into the self-signed dev certificate (first = CN).
SSL_CERT_DOMAINS=localhost,omnisense.local

# Profile-gated dev services started by `make up` (docker-compose.override.yml).
# Add worker,cron for a session that needs them: make up COMPOSE_PROFILES=mailer,cron,worker
COMPOSE_PROFILES=mailer,cron

###> web-auth/webauthn-symfony-bundle (required by omnibase) ###
RELYING_PARTY_ID=omnisense.local
RELYING_PARTY_NAME="Omnisense"
###< web-auth/webauthn-symfony-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
DEFAULT_URI=https://localhost:8633
###< symfony/routing ###

###> google/apiclient ###
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_CONFIG=%kernel.project_dir%/path/to/file.json
GOOGLE_MAPS_CLIENT_KEY=
###< google/apiclient ###

###> glitchr/omnibase ###
# Never ask a rate provider during a request.
BASE_TRADING_LIVE=0
###< glitchr/omnibase ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

###> glitchr/typesense-bundle ###
# The manuals' search (compose service "search"). The key is the container's
# own, on the internal network: a default, not a credential.
TYPESENSE_SCHEME=http
TYPESENSE_HOST=search
TYPESENSE_PORT=8108
TYPESENSE_SECRET=omnisense-search-key
TYPESENSE_API_KEY=${TYPESENSE_SECRET}
###< glitchr/typesense-bundle ###

###> the catalogue (app:packages:sync) ###
# Where the packages' repositories and the sites' composer.json are mounted,
# read only (docker-compose.override.yml).
OMNI_REPOS=/srv/repos
OMNI_SITES=/srv/sites
###< the catalogue ###

###> GitHub Sponsors (App\Sponsor\GitHubSponsors) ###
# A read-only token of the organisation's account. Empty: the Support page
# says there is no data yet, and nothing is asked of GitHub.
GITHUB_SPONSORS_TOKEN=
GITHUB_SPONSORS_LOGIN=glitchr-studio
###< GitHub Sponsors ###
