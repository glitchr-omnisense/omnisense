<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ app.request.locale|lang }}">
    <title>{{ site.name }} · {{ '@messages.news.title'|trans }}</title>
    <subtitle>{{ '@messages.news.description'|trans }}</subtitle>
    <id>{{ site_url('app_news') }}</id>
    <link rel="self" type="application/atom+xml" href="{{ site_url('app_news_atom') }}"/>
    <link rel="alternate" type="text/html" href="{{ site_url('app_news') }}"/>
    <updated>{{ (items|first ? (items|first).date : date('2026-01-01'))|date('Y-m-d\\TH:i:s\\Z', 'UTC') }}</updated>
    <author><name>{{ site.publisher }}</name></author>
{% for item in items %}
    <entry>
        <title>{{ item.title }}</title>
        <id>{{ site_url('app_news_item', {slug: item.slug}) }}</id>
        <link rel="alternate" type="text/html" href="{{ site_url('app_news_item', {slug: item.slug}) }}"/>
        <updated>{{ item.date|date('Y-m-d\\TH:i:s\\Z', 'UTC') }}</updated>
        <published>{{ item.date|date('Y-m-d\\TH:i:s\\Z', 'UTC') }}</published>
        {% if item.author %}<author><name>{{ item.author }}</name></author>{% endif %}
        <summary>{{ item.summary }}</summary>
        <content type="html">{{ item.rendered.html }}</content>
    </entry>
{% endfor %}
</feed>
