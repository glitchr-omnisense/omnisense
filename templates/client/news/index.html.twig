{# The news: news/*.<locale>.md, latest first, with the feeds. #}
{% extends 'layout1.html.twig' %}

{% block title %}{{ '@messages.news.title'|trans }}{% endblock %}
{% block description %}{{ '@messages.news.description'|trans }}{% endblock %}

{% block content %}
<div class="om-wrap om-page om-news-page">
    <header class="om-head is-page">
        <p class="om-cote">{{ '@messages.news.eyebrow'|trans }}</p>
        <h1>{{ '@messages.news.title'|trans }}</h1>
        <p class="om-lead">{{ '@messages.news.lead'|trans }}</p>
        <p class="om-actions"><a class="om-button is-line" href="{{ path('app_news_atom') }}" data-transparent-ignore>Atom</a> <a class="om-button is-line" href="{{ path('app_news_rss') }}" data-transparent-ignore>RSS</a></p>
    </header>
    {% if items %}
    <ol class="om-news-list">
        {% for item in items %}
        <li>
            <time datetime="{{ item.date|date('Y-m-d') }}">{{ item.date|format_date('long', locale: app.request.locale|lang) }}</time>
            <h2><a href="{{ path('app_news_item', {slug: item.slug}) }}">{{ item.title }}</a></h2>
            <p>{{ item.summary }}</p>
            {% if item.tags %}<p class="om-keywords">{% for tag in item.tags %}<span>{{ tag }}</span>{% endfor %}</p>{% endif %}
        </li>
        {% endfor %}
    </ol>
    {% else %}
    <p class="om-none">{{ '@messages.home.no_news'|trans }}</p>
    {% endif %}
</div>
{% endblock %}
