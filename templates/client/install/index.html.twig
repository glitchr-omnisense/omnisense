{#
 # Get started (as pytorch.org/get-started): rows of choices that combine,
 # the answer under them. The foundation only - the core, families, a bridge -
 # and, apart and optional, a prepared structure. Families are several
 # (checkboxes as pills); the chosen ones' providers are chips, family by
 # family, each family counted, the whole counted ("38 providers in omnibus +
 # omnilex", "12 of 38" once a filter narrows them).
 # A GET form: without JavaScript "Composer" sends the page again (the chosen
 # families' providers, checkboxes; the field takes names typed); with it,
 # install_controller.js opens the rows of the need chosen, shows the chosen
 # families' providers, narrows them as one types, and asks for the answer
 # alone at each change (?fragment=1), keeping the address in step.
 #}
{% extends 'layout1.html.twig' %}

{% block title %}{{ '@messages.install.title'|trans }}{% endblock %}
{% block description %}{{ '@messages.install.description'|trans }}{% endblock %}

{% macro choice(type, name, value, label, checked, disabled = false, note = null) %}
    <label class="om-pick{{ disabled ? ' is-off' }}">
        <input type="{{ type }}" name="{{ name }}" value="{{ value }}"{{ checked ? ' checked' }}{{ disabled ? ' disabled' }} data-action="change->install#update">
        <span><span class="om-pick-label">{{ label|raw }}</span>{% if note %}<small>{{ note }}</small>{% endif %}</span>
    </label>
{% endmacro %}

{% block content %}
{% import _self as ui %}
{% set symfony = plan.framework == 'symfony' %}
<div class="om-wrap om-page">
    <header class="om-head is-page">
        <p class="om-cote"><a href="{{ path('wikidoc_index') }}">{{ '@messages.nav.docs'|trans }}</a> / {{ '@messages.install.eyebrow'|trans }}</p>
        <h1>{{ '@messages.install.title'|trans }}</h1>
        <p class="om-lead">{{ '@messages.install.lead'|trans }}</p>
    </header>

    <form class="om-selector" method="get" action="{{ path('app_install') }}" data-controller="install" data-install-url-value="{{ path('app_install') }}">
        <div class="om-selector-row">
            <p class="om-selector-label" id="om-row-framework">{{ '@messages.install.framework'|trans }}</p>
            <div class="om-selector-choices" role="radiogroup" aria-labelledby="om-row-framework">
                {{ ui.choice('radio', 'framework', 'bare', '@messages.install.bare'|trans, plan.framework == 'bare') }}
                {{ ui.choice('radio', 'framework', 'symfony', 'Symfony', symfony) }}
                {{ ui.choice('radio', 'framework', 'laravel', 'Laravel', plan.framework == 'laravel', false, '@messages.install.laravel_note'|trans) }}
            </div>
        </div>

        <div class="om-selector-row">
            <p class="om-selector-label" id="om-row-channel">{{ '@messages.install.channel'|trans }}</p>
            <div class="om-selector-choices" role="radiogroup" aria-labelledby="om-row-channel">
                {{ ui.choice('radio', 'channel', 'stable', '@messages.install.stable'|trans, plan.channel == 'stable', false, '@messages.install.stable_note'|trans) }}
                {{ ui.choice('radio', 'channel', 'dev', '@messages.install.dev'|trans, plan.channel == 'dev', false, '@messages.install.dev_note'|trans) }}
            </div>
        </div>

        <div class="om-selector-row">
            <p class="om-selector-label" id="om-row-need">{{ '@messages.install.need'|trans }}</p>
            <div class="om-selector-choices" role="radiogroup" aria-labelledby="om-row-need">
                {% for need in ['core', 'family', 'bridge', 'structure'] %}
                {{ ui.choice('radio', 'need', need, ('@messages.install.need_' ~ need)|trans, choice.need == need, false, ('@messages.install.need_' ~ need ~ '_note')|trans) }}
                {% endfor %}
            </div>
        </div>

        <div class="om-selector-row" data-install-target="need" data-need="family"{{ choice.need != 'family' ? ' hidden' }}>
            <p class="om-selector-label" id="om-row-family">{{ '@messages.install.family'|trans }}<small>{{ '@messages.install.family_note'|trans }}</small></p>
            <div class="om-selector-choices is-dense" role="group" aria-labelledby="om-row-family">
                {% for name, own in families %}
                <label class="om-pick is-multi">
                    <input type="checkbox" name="family[]" value="{{ name }}"{{ name in choice.families ? ' checked' }} data-action="change->install#family" data-install-target="family" data-package="{{ own.name }}">
                    <span><span class="om-pick-label">omni<b>{{ family_suffix(name) }}</b> <small class="om-pick-count">{{ providers[name]|length }}</small></span></span>
                </label>
                {% endfor %}
            </div>
        </div>

        {# Every family's providers are here, the chosen families' shown: the script shows another family's at once. #}
        {% set offered = 0 %}{% set placeholder = [] %}
        {% for name in choice.families %}{% set offered = offered + providers[name]|length %}{% set placeholder = placeholder|merge(providers[name]|slice(0, 2)|map(p => p.shortName)) %}{% endfor %}
        <div class="om-selector-row" data-install-target="need" data-need="family"{{ choice.need != 'family' ? ' hidden' }}>
            <p class="om-selector-label" id="om-row-providers">{{ '@messages.install.providers'|trans }}<small>{{ '@messages.install.providers_note'|trans }}</small></p>
            <div class="om-selector-field om-providers">
                <p class="om-provider-count" aria-live="polite" data-install-target="count"
                   data-none="{{ '@messages.install.providers_no_family'|trans }}"
                   data-one="{{ '@messages.install.providers_count'|trans({count: 1, families: '%f'}) }}"
                   data-other="{{ '@messages.install.providers_count'|trans({count: 2, families: '%f'})|replace({'2': '%n'}) }}"
                   data-of="{{ '@messages.install.providers_of'|trans({shown: '%s', count: '%n', families: '%f'}) }}"
                   data-picked-one="{{ '@messages.install.providers_picked'|trans({count: 1}) }}"
                   data-picked-other="{{ '@messages.install.providers_picked'|trans({count: 2})|replace({'2': '%n'}) }}">
                    {%- if choice.families is empty -%}
                    {{ '@messages.install.providers_no_family'|trans }}
                    {%- else -%}
                    {{ '@messages.install.providers_count'|trans({count: offered, families: choice.familyList}) }}{% if choice.picked %} · {{ '@messages.install.providers_picked'|trans({count: choice.picked|length}) }}{% endif %}
                    {%- endif -%}
                </p>
                <div class="om-provider-filter">
                    <label for="om-providers">{{ '@messages.install.providers_filter'|trans }}</label>
                    <input id="om-providers" type="text" name="providers" value="{{ choice.providers }}" placeholder="{{ placeholder|slice(0, 3)|join(' ') }}" autocomplete="off" spellcheck="false" aria-controls="om-provider-groups" data-install-target="filter" data-action="input->install#filter keydown->install#filterKey">
                </div>
                <div class="om-provider-groups" id="om-provider-groups" data-install-target="groups">
                    {% for name, list in providers %}
                    {% set shown = name in choice.families %}
                    <fieldset class="om-provider-group" data-family="{{ name }}" data-install-target="group"{{ not shown ? ' hidden' }}>
                        <legend><span>omni<b>{{ family_suffix(name) }}</b></span> <span class="om-provider-tally" data-total="{{ list|length }}">{{ list|length }}</span></legend>
                        {% if list %}
                        <div class="om-provider-chips">
                            {% for provider in list %}
                            <label class="om-chip" title="{{ provider.description }}">
                                <input type="checkbox" name="provider[]" value="{{ provider.name }}"{{ provider.name in choice.picked ? ' checked' }}{{ not shown ? ' disabled' }} data-short="{{ provider.shortName }}" data-action="change->install#pick">
                                <span>{{ provider.shortName }}</span>
                            </label>
                            {% endfor %}
                        </div>
                        <p class="om-provider-none" hidden>{{ '@messages.install.providers_none_match'|trans }}</p>
                        {% else %}
                        <p class="om-provider-none">{{ '@messages.install.providers_none'|trans }}</p>
                        {% endif %}
                    </fieldset>
                    {% endfor %}
                </div>
                <p class="om-selector-hint"><a href="{{ path('app_packages') ~ '?' ~ (choice.families|length == 1 ? {family: choice.families|first, kind: 'provider'} : {kind: 'provider'})|url_encode }}" data-install-target="browse">{{ '@messages.install.providers_browse'|trans }}</a></p>
            </div>
        </div>

        <div class="om-selector-row" data-install-target="need" data-need="bridge"{{ choice.need != 'bridge' ? ' hidden' }}>
            <p class="om-selector-label" id="om-row-bridge">{{ '@messages.install.bridge'|trans }}</p>
            <div class="om-selector-choices" role="radiogroup" aria-labelledby="om-row-bridge">
                {% for package in bridge_packages %}
                {{ ui.choice('radio', 'bridge', package.name, package.name|omni_mark, choice.bridge == package.name, false, package.description) }}
                {% endfor %}
            </div>
        </div>

        <div class="om-selector-row is-optional" data-install-target="need" data-need="structure"{{ choice.need != 'structure' ? ' hidden' }}>
            <p class="om-selector-label"><label for="om-structure">{{ '@messages.install.structure'|trans }}</label><small>{{ '@messages.install.structure_note'|trans }}</small></p>
            <div class="om-selector-field">
                <select id="om-structure" name="structure" data-action="change->install#update">
                    {% for package in structures %}
                    <option value="{{ package.name }}"{{ choice.structure == package.name ? ' selected' }}>{{ package.name }}{{ package.description ? ' — ' ~ (package.description|length > 70 ? package.description|slice(0, 69) ~ '…' : package.description) }}</option>
                    {% endfor %}
                </select>
                <p class="om-selector-hint">{{ '@messages.install.structure_hint'|trans }}</p>
            </div>
        </div>

        <p class="om-selector-send" data-install-target="send"><button type="submit" class="om-button">{{ '@messages.install.submit'|trans }}</button></p>

        <div class="om-selector-answer" data-install-target="answer" aria-live="polite">
            {% include 'client/install/_answer.html.twig' %}
        </div>
    </form>

    {# The home's section, not a tier: its long title over its lead, not beside it. #}
    <section class="om-section om-anchor" id="compatibility">
        {% include 'partials/_compatibility.html.twig' %}
    </section>
</div>
{% endblock %}
