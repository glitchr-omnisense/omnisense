{#
 # The sites built on the ecosystem: one sentence and one link each, and
 # the packages each requires (read in its composer.json). A demonstration
 # whose person or firm is invented says so, here as on its own pages.
 #}
{% extends 'layout1.html.twig' %}

{% block title %}{{ '@messages.demos.title'|trans }}{% endblock %}
{% block description %}{{ '@messages.demos.description'|trans }}{% endblock %}

{% block content %}
<div class="om-wrap om-page">
    <header class="om-head is-page">
        <p class="om-cote">{{ '@messages.demos.eyebrow'|trans }}</p>
        <h1>{{ '@messages.demos.title'|trans }}</h1>
        <p class="om-lead">{{ '@messages.demos.lead'|trans }}</p>
        <p class="om-source">{{ '@messages.demos.local'|trans }}</p>
    </header>

    {% for kind, sites in groups %}
    <section class="om-tier is-{{ kind }}" id="{{ kind }}">
        <header><h2>{{ ('@messages.demos.kind.' ~ kind)|trans }} <small>{{ sites|length }}</small></h2><p>{{ ('@messages.demos.kind_text.' ~ kind)|trans }}</p></header>
        <ul class="om-demos">
            {% for site in sites %}
            <li>
                <h3><a href="{{ site.url }}" rel="noopener">{{ site.name }}</a>{% if site.fictional %} <em class="om-fictional">{{ '@messages.demos.fictional'|trans }}</em>{% endif %}</h3>
                <p>{{ ('@messages.sites.' ~ site.slug|replace({'-': '_'}))|trans }}</p>
                <p class="om-demo-address"><a href="{{ site.url }}" rel="noopener">{{ site.url|replace({'https://': ''}) }}</a></p>
                {% if site.packages %}
                <p class="om-names">{% for package in site.packages %}<a href="{{ path('app_package', {vendor: package.vendor, name: package.shortName}) }}">{{ package.name }}</a>{% endfor %}</p>
                {% else %}
                <p class="om-none">{{ '@messages.demos.no_package'|trans }}</p>
                {% endif %}
            </li>
            {% endfor %}
        </ul>
    </section>
    {% endfor %}
</div>
{% endblock %}
