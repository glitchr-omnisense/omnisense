{#
 # A package: what its catalogue entry says of it (description, licence,
 # branch, what it requires), whether its README says it was tried for real -
 # with the README's own sentence -, and its manual: the series, the contents.
 #}
{% extends 'layout1.html.twig' %}

{% block title %}{{ package.name }}{% endblock %}
{% block description %}{{ package.description ?? package.name }}{% endblock %}

{% block content %}
<div class="om-wrap om-page">
    <header class="om-head is-page">
        <p class="om-cote">
            <a href="{{ path('app_packages') }}">{{ '@messages.catalogue.title'|trans }}</a>
            {% if family and family.hasPage %} / <a href="{{ path('app_family', {family: family.name}) }}">Omni{{ family.suffix }}</a>{% endif %}
            / {{ ('@messages.floors.' ~ package.tier.value ~ '.one')|trans }}
        </p>
        <h1 class="om-package-title"><span>{{ package.npm ? '@' }}{{ package.vendor }}/</span>{{ package.shortName }}</h1>
        {% if package.description %}<p class="om-lead">{{ package.description }}</p>{% endif %}
        {% if package.tier.value == 'component' %}<p class="om-optional-note"><span class="om-optional">{{ '@messages.structures.optional'|trans }}</span> {{ '@messages.structures.optional_note'|trans }}</p>{% endif %}

        <div class="om-install">
            <code data-copy-source>{{ package.installCommand }}</code>
            <p class="om-install-note">{{ '@messages.package.dev_branch'|trans }}</p>
        </div>

        <div class="om-actions">
            {% if manual %}<a class="om-button" href="{{ path('app_manual', {key: manual.key, series: manual.default}) }}">{{ '@messages.package.read_manual'|trans }}</a>{% endif %}
            {% if package.repositoryUrl %}<a class="om-button is-line" href="{{ package.repositoryUrl }}" rel="noopener">{{ '@messages.package.repository'|trans }}</a>{% endif %}
            <a class="om-button is-line" href="{{ package.registryUrl }}" rel="noopener">{{ package.registry }}</a>
        </div>
    </header>

    <div class="om-package-grid">
        <section class="om-sheet" aria-labelledby="om-sheet-title">
            <h2 id="om-sheet-title" class="om-cote">{{ '@messages.package.sheet'|trans }}</h2>
            <dl>
                <div><dt>{{ '@messages.package.floor'|trans }}</dt><dd>{{ ('@messages.floors.' ~ package.tier.value ~ '.one')|trans }}{% if family and family.hasPage and family.own != package %} · <a href="{{ path('app_family', {family: family.name}) }}">Omni{{ family.suffix }}</a>{% endif %}</dd></div>
                <div><dt>{{ '@messages.package.license'|trans }}</dt><dd>{{ package.license ?? '—' }}</dd></div>
                <div><dt>{{ '@messages.package.branch'|trans }}</dt><dd>{% if package.branch %}<code>{{ package.branch }}</code>{% else %}—{% endif %}</dd></div>
                <div><dt>{{ '@messages.package.repository'|trans }}</dt><dd>{% if package.repositoryUrl %}<a href="{{ package.repositoryUrl }}" rel="noopener">{{ package.repository }}</a>{% else %}—{% endif %}</dd></div>
                <div>
                    <dt>{{ '@messages.package.verified'|trans }}</dt>
                    <dd>
                        <span class="om-fact is-{{ package.verification.value }}">{{ ('@messages.state.' ~ package.verification.value)|trans }}</span>
                        {% if package.verificationNote %}<blockquote class="om-quote"><p>{{ package.verificationNote }}</p><footer>{{ '@messages.package.from_readme'|trans }}</footer></blockquote>{% endif %}
                    </dd>
                </div>
                {% if package.keywords %}<div><dt>{{ '@messages.package.keywords'|trans }}</dt><dd class="om-keywords">{% for keyword in package.keywords %}<span>{{ keyword }}</span>{% endfor %}</dd></div>{% endif %}
            </dl>
        </section>

        <div class="om-package-main">
            <section class="om-tier" id="manual">
                <header><h2>{{ '@messages.package.manual'|trans }}</h2></header>
                {% if manual %}
                <p class="om-manual-versions">
                    {{ '@messages.package.versions'|trans({count: manual.series|length}) }}
                    {% for s in manual.series %}<a href="{{ path('app_manual', {key: manual.key, series: s}) }}"{% if s == manual.default %} aria-current="true"{% endif %}>{{ s }}</a>{% endfor %}
                </p>
                {% if tree %}
                <div class="om-contents">{% include 'partials/_doc_tree.html.twig' with {series: manual.default, current: null, home: true} %}</div>
                {% endif %}
                {% else %}
                <p class="om-none">{{ '@messages.package.no_manual'|trans }}</p>
                {% endif %}
            </section>

            {% if requires or required_by %}
            <section class="om-tier">
                <header><h2>{{ '@messages.package.links'|trans }}</h2></header>
                {% if requires %}
                <h3 class="om-cote">{{ '@messages.package.requires'|trans }}</h3>
                <ul class="om-rows">{% for other in requires %}{% include 'partials/_package_row.html.twig' with {package: other} %}{% endfor %}</ul>
                {% endif %}
                {% if required_by %}
                <h3 class="om-cote">{{ '@messages.package.required_by'|trans({count: required_by|length}) }}</h3>
                <p class="om-names">{% for other in required_by %}<a href="{{ path('app_package', {vendor: other.vendor, name: other.shortName}) }}">{{ other.name }}</a>{% endfor %}</p>
                {% endif %}
            </section>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
