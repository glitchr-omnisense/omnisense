{#
 # The home page, section by section (StickyStops: each section is a stop):
 # Omni and its turning suffix, the search through every manual and one tag
 # per family; omnibase and the families side by side; omnibridge, the glue
 # to a framework; the families, a contract each; which frameworks it runs
 # in; where to read on. Every name and every number comes from the catalogue
 # (app:packages:sync): a family is shown because its repository was found.
 # The way on is the documentation (Marco, 2026-10-10): nothing here counts
 # or names the sites built on the packages.
 #}
{% extends 'layout1.html.twig' %}

{% block description %}{{ '@messages.site.description'|trans }}{% endblock %}

{% block content %}
{% set first = families|first %}
<section class="om-hero sticky-stop" id="omni" data-controller="suffix" data-suffix-interval-value="2800">
    <div class="om-wrap om-hero-inner">
        <h1 class="visually-hidden">{{ '@messages.home.title'|trans }}</h1>
        <p class="om-kicker"><span>{{ '@messages.home.kicker'|trans }}</span> <span class="om-cote">{{ '@messages.home.kicker_count'|trans({packages: counts.packages, families: families|length}) }}</span></p>

        {% if first %}
        <p class="om-omni" aria-hidden="true"><span class="om-omni-fixed">Omni</span><a class="om-omni-slot" href="{{ path('wikidoc_index') }}" tabindex="-1" data-suffix-target="slot"><span class="is-in">{{ first.suffix }}</span></a></p>
        <p class="om-omni-phrase" data-suffix-target="phrase">{{ ('@messages.families.' ~ first.name ~ '.phrase')|trans }}</p>

        {% else %}
        <p class="om-omni" aria-hidden="true"><span class="om-omni-fixed">Omni</span></p>
        <p class="om-omni-phrase">{{ '@messages.home.empty'|trans }}</p>
        {% endif %}

        <div class="om-hero-find">
            <form class="om-search" role="search" action="{{ path('wikidoc_search') }}" method="get">
                <label for="om-home-q">{{ '@messages.home.search_label'|trans }}</label>
                <div><input id="om-home-q" type="search" name="q" placeholder="{{ '@messages.home.search_placeholder'|trans }}" autocomplete="off" spellcheck="false"><button type="submit" class="om-button">{{ '@messages.home.search_submit'|trans }}</button></div>
            </form>
            {% if families %}
            <ul class="om-omni-tags" aria-label="{{ '@messages.home.tags_label'|trans }}">
                {% for family in families %}
                <li><a href="{{ path('wikidoc_manual', {path: 'glitchr/' ~ family.name}) }}" data-suffix-target="item" data-action="mouseenter->suffix#pick focus->suffix#pick" data-suffix="{{ family.suffix }}" data-phrase="{{ ('@messages.families.' ~ family.name ~ '.phrase')|trans }}"{% if loop.first %} aria-current="true"{% endif %}>omni<b>{{ family.suffix }}</b><span class="visually-hidden">: {{ ('@messages.families.' ~ family.name ~ '.phrase')|trans }}</span></a></li>
                {% endfor %}
            </ul>
            {% endif %}
        </div>

        <p class="om-actions">
            <a class="om-button" href="{{ path('wikidoc_index') }}">{{ '@messages.start.to_docs'|trans }}</a>
            <a class="om-button is-line" href="{{ path('app_install') }}">{{ '@messages.start.to_install'|trans }}</a>
        </p>
    </div>
</section>

<section class="om-section om-floors sticky-stop" id="floors">
    <div class="om-wrap">
        <header class="om-head">
            <p class="om-cote">A — {{ '@messages.floors.eyebrow'|trans }}</p>
            <h2>{{ '@messages.floors.title'|trans }}</h2>
            <p class="om-lead">{{ '@messages.floors.lead'|trans }}</p>
        </header>

        {# The section drawing: two stacks, read from the top. On the left omnibase, its core (1) then its
         # extensions (2); on the right a family (3) then its providers (4). The examples turn one at a
         # time (examples_controller.js); a family and the providers beside it are always of one domain. #}
        {% set shown = {
            foundation: floors.foundation|map(p => p.name)|slice(0, 3),
            component: extensions|slice(0, 3),
            family: pairs|slice(0, 3)|map(p => p.family),
            provider: pairs|slice(0, 3)|map(p => p.providers|first),
        } %}
        <div class="om-section-drawing" data-controller="examples" data-examples-extensions-value="{{ extensions|json_encode }}" data-examples-pairs-value="{{ pairs|json_encode }}">
            {% for stack in [['foundation', 'component'], ['family', 'provider']] %}
            <div class="om-stack is-{{ loop.first ? 'house' : 'outside' }}">
                <p class="om-stack-title">{{ ('@messages.floors.stack_' ~ (loop.first ? 'house' : 'outside'))|trans }}</p>
                {% for tier in stack %}
                {% set packages = floors[tier] %}
                <a class="om-floor is-{{ tier }}" href="{{ path('app_packages') }}#{{ tier }}">
                    <span class="om-floor-level">{{ {'foundation': '1', 'component': '2', 'family': '3', 'provider': '4'}[tier] }}</span>
                    <span class="om-floor-body">
                        <span class="om-floor-name">{{ ('@messages.floors.' ~ tier ~ '.name')|trans }}</span>
                        <code class="om-floor-pattern">{{ ('@messages.floors.' ~ tier ~ '.pattern')|trans|omni_mark }}</code>
                        <span class="om-floor-text">{{ ('@messages.floors.' ~ tier ~ '.text')|trans }}</span>
                        <span class="om-floor-examples">
                            {%- for name in shown[tier] %}<code data-examples-target="{{ tier }}">{{ name|omni_mark }}</code>{% endfor -%}
                            {%- if packages|length > shown[tier]|length %}<span>+ {{ packages|length - shown[tier]|length }}</span>{% endif -%}
                        </span>
                    </span>
                    <span class="om-floor-count"><b>{{ packages|length }}</b> {{ '@messages.floors.packages'|trans({count: packages|length}) }}</span>
                </a>
                {% endfor %}
            </div>
            {% endfor %}
        </div>
        <p class="om-floors-note">{{ '@messages.floors.note'|trans }}{% if floors.library|length %} {{ '@messages.floors.libraries'|trans({count: floors.library|length, url: path('app_packages') ~ '#library'})|raw }}{% endif %}</p>
    </div>
</section>

{# omnibridge: the glue between omnibase and a framework. The targets are plan 0's (rule 13); a bridge found in a repository links to its card. #}
{% set found_bridges = {} %}
{% for package in floors.bridge %}{% set found_bridges = found_bridges|merge({(package.name): package}) %}{% endfor %}
<section class="om-section om-bridges sticky-stop" id="bridges">
    <div class="om-wrap">
        <header class="om-head">
            <p class="om-cote">B — {{ '@messages.home.bridges_eyebrow'|trans }}</p>
            <h2>{{ '@messages.home.bridges_title'|trans }}</h2>
            <p class="om-lead">{{ '@messages.home.bridges_lead'|trans }}</p>
        </header>
        <ul class="om-family-list om-bridge-list">
            {% for target in ['symfony', 'doctrine', 'twig', 'composer', 'laravel'] %}
            {% set package = found_bridges['omnibridge/' ~ target]|default(null) %}
            <li>
                <a href="{{ package ? path('app_package', {vendor: package.vendor, name: package.shortName}) : path('app_packages') ~ '#bridge' }}">
                    <span class="om-family-name">omnibridge/<b>{{ target }}</b></span>
                    <span class="om-family-question">{{ ('@messages.home.bridge_' ~ target)|trans }}</span>
                    <span class="om-family-count">{{ (package ? '@messages.home.bridge_found' : '@messages.home.bridge_planned')|trans }}</span>
                </a>
            </li>
            {% endfor %}
        </ul>
    </div>
</section>

<section class="om-section om-families sticky-stop" id="families">
    <div class="om-wrap">
        <header class="om-head">
            <p class="om-cote">C — {{ '@messages.home.families_eyebrow'|trans }}</p>
            <h2>{{ '@messages.home.families_title'|trans }}</h2>
            <p class="om-lead">{{ '@messages.home.families_lead'|trans }}</p>
        </header>
        <ul class="om-family-list">
            {% for family in families %}
            <li>
                <a href="{{ path('app_family', {family: family.name}) }}">
                    <span class="om-family-name">Omni<b>{{ family.suffix }}</b></span>
                    <span class="om-family-question">{{ ('@messages.families.' ~ family.name ~ '.phrase')|trans }}</span>
                    <span class="om-family-count">{{ family.name == 'omnibase' ? '@messages.home.components'|trans({count: family.members}) : '@messages.home.providers'|trans({count: family.members}) }}</span>
                </a>
            </li>
            {% endfor %}
        </ul>
    </div>
</section>

<section class="om-section om-compat-section sticky-stop" id="compatibility">
    <div class="om-wrap">
        {% include 'partials/_compatibility.html.twig' with {letter: 'D', bridges: '#bridges'} %}
    </div>
</section>

<section class="om-section om-read sticky-stop" id="read">
    <div class="om-wrap om-read-grid">
        <div>
            <header class="om-head">
                <p class="om-cote">E — {{ '@messages.home.read_eyebrow'|trans }}</p>
                <h2>{{ '@messages.home.read_title'|trans }}</h2>
                <p class="om-lead">{{ '@messages.home.read_lead'|trans }}</p>
            </header>
            <dl class="om-figures">
                <div><dt>{{ '@messages.home.figure_packages'|trans }}</dt><dd>{{ counts.packages }}</dd></div>
                <div><dt>{{ '@messages.home.figure_manuals'|trans }}</dt><dd>{{ counts.manuals }}</dd></div>
                <div><dt>{{ '@messages.home.figure_families'|trans }}</dt><dd>{{ families|length }}</dd></div>
            </dl>
            <p class="om-actions"><a class="om-button" href="{{ path('wikidoc_index') }}">{{ '@messages.start.to_docs'|trans }}</a> <a class="om-button is-line" href="{{ path('app_support') }}">{{ '@messages.home.to_support'|trans }}</a></p>
        </div>
        <div class="om-news">
            <h3 class="om-cote">{{ '@messages.home.news'|trans }}</h3>
            {% if posts %}
            <ol>
                {% for post in posts %}
                <li>
                    <time datetime="{{ post.publishedAt|date('Y-m-d') }}">{{ post.publishedAt|format_date('medium') }}</time>
                    <a href="{{ path('blog_post', {slug: post.slug}) }}">{{ post.title }}</a>
                    {% if post.headline %}<p>{{ post.headline }}</p>{% endif %}
                </li>
                {% endfor %}
            </ol>
            <p><a class="om-more" href="{{ path('blog_index') }}">{{ '@messages.home.all_news'|trans }}</a></p>
            {% else %}
            <p class="om-none">{{ '@messages.home.no_news'|trans }}</p>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}
