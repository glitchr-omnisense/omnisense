{#
 # The home page, section by section (StickyStops: each section is a stop):
 # Omni and its turning suffix, the search through every manual and one tag
 # per family; the foundation - the core, the families, the bridges; the
 # families, a contract each, their providers counted and left to the search;
 # omnibridge, the glue to a framework; apart and optional, the prepared
 # structures; which frameworks it runs in; where to read on. No provider is
 # named here, and the prepared structures never stand among the families.
 # Every name and every number comes from the catalogue (catalog/*.yaml).
 # The way on is the documentation (Marco, 2026-10-10): nothing here counts
 # or names the sites built on the packages.
 #}
{% extends 'layout1.html.twig' %}

{% block description %}{{ '@messages.site.description'|trans }}{% endblock %}

{% block content %}
{% set first = families|first %}
<section class="om-hero sticky-stop" id="omni" data-controller="suffix" data-suffix-interval-value="2800">
    <div class="om-wrap om-hero-inner">
        <h1 class="visually-hidden">{{ '@messages.home.title'|trans }}</h1>
        <p class="om-kicker"><span>{{ '@messages.home.kicker'|trans }}</span> <span class="om-cote">{{ '@messages.home.kicker_count'|trans({packages: counts.packages, families: floors.family|length}) }}</span></p>

        {% if first %}
        <p class="om-omni" aria-hidden="true"><span class="om-omni-fixed">Omni</span><a class="om-omni-slot" href="{{ path('app_docs') }}" tabindex="-1" data-suffix-target="slot"><span class="is-in">{{ first.suffix }}</span></a></p>
        <p class="om-omni-phrase" data-suffix-target="phrase">{{ first.phrase }}</p>

        {% else %}
        <p class="om-omni" aria-hidden="true"><span class="om-omni-fixed">Omni</span></p>
        <p class="om-omni-phrase">{{ '@messages.home.empty'|trans }}</p>
        {% endif %}

        <div class="om-hero-find">
            <form class="om-search" role="search" action="{{ path('app_search') }}" method="get">
                <label for="om-home-q">{{ '@messages.home.search_label'|trans }}</label>
                <div><input id="om-home-q" type="search" name="q" placeholder="{{ '@messages.home.search_placeholder'|trans }}" autocomplete="off" spellcheck="false"><button type="submit" class="om-button">{{ '@messages.home.search_submit'|trans }}</button></div>
            </form>
            {% if families %}
            <ul class="om-omni-tags" aria-label="{{ '@messages.home.tags_label'|trans }}">
                {% for family in families %}
                <li><a href="{{ path('app_family', {family: family.name}) }}" data-suffix-target="item" data-action="mouseenter->suffix#pick focus->suffix#pick" data-suffix="{{ family.suffix }}" data-phrase="{{ family.phrase }}"{% if loop.first %} aria-current="true"{% endif %}>omni<b>{{ family.suffix }}</b><span class="visually-hidden">: {{ family.phrase }}</span></a></li>
                {% endfor %}
            </ul>
            {% endif %}
        </div>

        <p class="om-actions">
            <a class="om-button" href="{{ path('app_docs') }}">{{ '@messages.start.to_docs'|trans }}</a>
            {% if guides['getting-started'] is defined %}<a class="om-button is-line" href="{{ path('app_guide', {slug: 'getting-started'}) }}">{{ guides['getting-started'].title }}</a>{% endif %}
        </p>
    </div>
</section>

<section class="om-section om-floors sticky-stop" id="floors">
    <div class="om-wrap">
        <header class="om-head">
            <p class="om-cote">A — {{ '@messages.floors.eyebrow'|trans }}</p>
            <h2>{{ '@messages.floors.title'|trans }}</h2>
            <p class="om-lead">{{ '@messages.floors.lead'|trans }}</p>
        </header>

        {# The foundation's section drawing, read from the left: the core (1), the families (2), the bridges (3).
         # The families' examples turn one at a time (examples_controller.js); providers are only counted. #}
        {% set providers_count = floors.provider|length %}
        <div class="om-section-drawing is-foundation" data-controller="examples" data-examples-families-value="{{ turning|json_encode }}">
            {% set shown = turning|slice(0, 2) %}
            {% for tier, level in {foundation: '1', family: '2', bridge: '3'} %}
            {% set packages = floors[tier] %}
            {# The core is named by its pattern (its name as the catalogue has it): no example beside it. #}
            {% set examples = tier == 'family' ? shown : (tier == 'bridge' ? packages|map(p => p.name)|slice(0, 4) : []) %}
            <a class="om-floor is-{{ tier }}" href="{{ (path('app_packages') ~ '#' ~ {kind: tier == 'foundation' ? 'core' : tier}|url_encode) }}">
                <span class="om-floor-level">{{ level }}</span>
                <span class="om-floor-body">
                    <span class="om-floor-name">{{ ('@messages.floors.' ~ tier ~ '.name')|trans }}</span>
                    <code class="om-floor-pattern">{{ (tier == 'foundation' and packages|length ? packages|first.name : ('@messages.floors.' ~ tier ~ '.pattern')|trans)|omni_mark }}</code>
                    <span class="om-floor-text">{{ ('@messages.floors.' ~ tier ~ '.text')|trans }}</span>
                    {% if examples %}<span class="om-floor-examples">
                        {%- for name in examples %}<code{% if tier == 'family' %} data-examples-target="family"{% endif %}>{{ name|omni_mark }}</code>{% endfor -%}
                        {%- if packages|length > examples|length %}<span>+ {{ packages|length - examples|length }}</span>{% endif -%}
                    </span>{% endif %}
                </span>
                <span class="om-floor-count"><b>{{ packages|length }}</b> {{ '@messages.floors.packages'|trans({count: packages|length}) }}{% if tier == 'family' %} · {{ '@messages.floors.providers_count'|trans({count: providers_count}) }}{% endif %}</span>
            </a>
            {% endfor %}
        </div>
        <p class="om-floors-note">{{ '@messages.floors.note'|trans }}{% if floors.library|length %} {{ '@messages.floors.libraries'|trans({count: floors.library|length, url: (path('app_packages') ~ '#' ~ {kind: 'library'}|url_encode)})|raw }}{% endif %}</p>
    </div>
</section>

<section class="om-section om-families sticky-stop" id="families">
    <div class="om-wrap">
        <header class="om-head">
            <p class="om-cote">B — {{ '@messages.home.families_eyebrow'|trans }}</p>
            <h2>{{ '@messages.home.families_title'|trans }}</h2>
            <p class="om-lead">{{ '@messages.home.families_lead'|trans }}</p>
        </header>
        <ul class="om-family-list is-rows">
            {% for family in families|filter(f => f.package.tier.value == 'family') %}
            <li>
                <a class="om-family-name" href="{{ path('app_family', {family: family.name}) }}">Omni<b>{{ family.suffix }}</b></a>
                <span class="om-family-question">{{ family.phrase }}</span>
                <a class="om-family-count" href="{{ (path('app_packages') ~ '#' ~ {family: family.name, kind: 'provider'}|url_encode) }}">{{ '@messages.home.providers'|trans({count: family.members}) }}</a>
            </li>
            {% endfor %}
        </ul>
    </div>
</section>

{# omnibridge: the glue between omnibase and a framework. The targets are plan 0's (rule 13); a bridge found in a repository links to its card. #}
{% set found_bridges = {} %}
{% for package in floors.bridge %}{% set found_bridges = found_bridges|merge({(package.name): package}) %}{% endfor %}
<section class="om-section om-bridges sticky-stop" id="bridges">
    <div class="om-wrap">
        <header class="om-head">
            <p class="om-cote">C — {{ '@messages.home.bridges_eyebrow'|trans }}</p>
            <h2>{{ '@messages.home.bridges_title'|trans }}</h2>
            <p class="om-lead">{{ '@messages.home.bridges_lead'|trans }}</p>
        </header>
        <ul class="om-family-list om-bridge-list">
            {% for target in ['symfony', 'doctrine', 'twig', 'react', 'composer', 'laravel'] %}
            {% set package = found_bridges['omnibridge/' ~ target]|default(null) %}
            <li>
                <a href="{{ package ? path('app_package', {vendor: package.vendor, name: package.shortName}) : (path('app_packages') ~ '#' ~ {kind: 'bridge'}|url_encode) }}">
                    <span class="om-family-name">omnibridge/<b>{{ target }}</b></span>
                    <span class="om-family-question">{{ ('@messages.home.bridge_' ~ target)|trans }}</span>
                    <span class="om-family-count">{{ (package ? '@messages.home.bridge_found' : '@messages.home.bridge_planned')|trans }}</span>
                </a>
            </li>
            {% endfor %}
        </ul>
    </div>
</section>

{# Apart, and optional: the prepared structures. Nothing in the core or the families depends on them. #}
<section class="om-section om-structures sticky-stop" id="structures">
    <div class="om-wrap">
        <header class="om-head">
            <p class="om-cote">D — <span class="om-optional">{{ '@messages.structures.optional'|trans }}</span> {{ '@messages.structures.eyebrow'|trans }}</p>
            <h2>{{ '@messages.structures.title'|trans }}</h2>
            <p class="om-lead">{{ '@messages.floors.component.text'|trans }}</p>
        </header>
        {% set shown = structures|slice(0, 3) %}
        <div class="om-section-drawing is-optional" data-controller="examples" data-examples-structures-value="{{ structures|json_encode }}">
            <a class="om-floor is-component" href="{{ (path('app_packages') ~ '#' ~ {kind: 'structure'}|url_encode) }}">
                <span class="om-floor-level" aria-hidden="true">+</span>
                <span class="om-floor-body">
                    <span class="om-floor-name">{{ '@messages.floors.component.name'|trans }}</span>
                    <code class="om-floor-pattern">{{ '@messages.floors.component.pattern'|trans|omni_mark }}</code>
                    <span class="om-floor-examples">
                        {%- for name in shown %}<code data-examples-target="component">{{ name|omni_mark }}</code>{% endfor -%}
                        {%- if structures|length > shown|length %}<span>+ {{ structures|length - shown|length }}</span>{% endif -%}
                    </span>
                </span>
                <span class="om-floor-count"><b>{{ structures|length }}</b> {{ '@messages.structures.count'|trans({count: structures|length}) }}</span>
            </a>
            <p class="om-structures-note">{{ '@messages.structures.note'|trans }}</p>
        </div>
    </div>
</section>

<section class="om-section om-compat-section sticky-stop" id="compatibility">
    <div class="om-wrap">
        {% include 'partials/_compatibility.html.twig' with {letter: 'E', bridges: '#bridges'} %}
    </div>
</section>

<section class="om-section om-read sticky-stop" id="read">
    <div class="om-wrap om-read-grid">
        <div>
            <header class="om-head">
                <p class="om-cote">F — {{ '@messages.home.read_eyebrow'|trans }}</p>
                <h2>{{ '@messages.home.read_title'|trans }}</h2>
                <p class="om-lead">{{ '@messages.home.read_lead'|trans }}</p>
            </header>
            <dl class="om-figures">
                <div><dt>{{ '@messages.home.figure_packages'|trans }}</dt><dd>{{ counts.packages }}</dd></div>
                <div><dt>{{ '@messages.home.figure_manuals'|trans }}</dt><dd>{{ counts.manuals }}</dd></div>
                <div><dt>{{ '@messages.home.figure_families'|trans }}</dt><dd>{{ floors.family|length }}</dd></div>
            </dl>
            <p class="om-actions"><a class="om-button" href="{{ path('app_docs') }}">{{ '@messages.start.to_docs'|trans }}</a> <a class="om-button is-line" href="{{ path('app_support') }}">{{ '@messages.home.to_support'|trans }}</a></p>
        </div>
        <div class="om-news">
            <h3 class="om-cote">{{ '@messages.home.news'|trans }}</h3>
            {% if posts %}
            <ol>
                {% for post in posts %}
                <li>
                    <time datetime="{{ post.date|date('Y-m-d') }}">{{ post.date|format_date('medium', locale: app.request.locale|lang) }}</time>
                    <a href="{{ path('app_news_item', {slug: post.slug}) }}">{{ post.title }}</a>
                    <p>{{ post.summary }}</p>
                </li>
                {% endfor %}
            </ol>
            <p><a class="om-more" href="{{ path('app_news') }}">{{ '@messages.home.all_news'|trans }}</a></p>
            {% else %}
            <p class="om-none">{{ '@messages.home.no_news'|trans }}</p>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}
