{% extends "base.html.twig" %}

{#
 # The page as a sheet of a plan: the title block at the top - the mark, the
 # sections of the site, the tools -, #content, which transparent.js swaps
 # on a navigation, and the cartouche at the bottom: the plan of the site,
 # where the packages live, the legal pages, and Glitch Art's signature.
 #}

{% block layout_name %}omnisense{% endblock %}

{% block stylesheets_layout %}
    {{ encore_entry_link_tags('layout1') }}
{% endblock %}

{% set route = app.request.attributes.get('_route')|default('') %}
{#- The section the page belongs to: the route's name without its locale (app_package.fr → app_package.). -#}

{% block layout %}
<a class="om-skip" href="#content">{{ '@messages.nav.skip'|trans }}</a>

<header class="om-header" data-controller="menu" data-action="menu:close->menu#close">
    <div class="om-wrap om-header-inner">
        <a class="om-mark" href="{{ path('app_index') }}" aria-label="{{ site.name }}"><b>Omni</b><i>sense</i></a>
        <nav class="om-nav" id="om-nav" aria-label="{{ '@messages.nav.label'|trans }}">
            <ul>
                <li><a href="{{ path('app_docs') }}" {{ route starts with 'app_docs' or route starts with 'app_guide' or route starts with 'app_manual' ? 'aria-current="page"' }}>{{ '@messages.nav.docs'|trans }}</a></li>
                <li><a href="{{ path('app_packages') }}" {{ route starts with 'app_packages' or route starts with 'app_package.' or route starts with 'app_family' ? 'aria-current="page"' }}>{{ '@messages.nav.packages'|trans }}</a></li>
                <li><a href="{{ path('app_news') }}" {{ route starts with 'app_news' ? 'aria-current="page"' }}>{{ '@messages.nav.blog'|trans }}</a></li>
                <li><a href="{{ path('app_search') }}" {{ route starts with 'app_search' ? 'aria-current="page"' }}>{{ '@messages.nav.search'|trans }}</a></li>
                <li><a href="{{ path('app_support') }}" {{ route starts with 'app_support' ? 'aria-current="page"' }}>{{ '@messages.nav.support'|trans }}</a></li>
            </ul>
        </nav>
        <button type="button" class="om-menu-button" data-menu-target="button" data-action="menu#toggle" aria-controls="om-nav" aria-expanded="false">{{ '@messages.nav.menu'|trans }}</button>
        {% include 'partials/_tools.html.twig' %}
    </div>
</header>

<main id="content" tabindex="-1">
    {% block content %}{% endblock %}
</main>

<footer class="om-footer">
    <div class="om-wrap">
        <div class="om-footer-grid">
            {#- Its name and what it is, Glitch Art's signature at their left (as on Anaëlle's and Brieuc's sites): the
             # year and the monkey as tall as the two lines, the time the page took under them, a dotted rule between.
             # Black, white at night. -#}
            <div class="om-footer-id">
                <div class="om-footer-sign">
                    {% include '@Base/partials/_credits.html.twig' with {color: 'black', detail: false} %}
                    {#- Served by the kernel, the time the request took; in the static export (omnibridge/static renders
                     # every page in one process, where that time is the whole build's so far and differs from one
                     # build to the next), the time the visitor's browser took to make the page ready, written by
                     # app-defer.js. -#}
                    {% if app.request and app.request.headers.get('User-Agent') == 'omnibridge-static' %}
                    <span class="om-footer-time" data-page-time></span>
                    {% else %}
                    <span class="om-footer-time">[{{ app.site.execution_time|default(0)|number_format(2) }}s]</span>
                    {% endif %}
                </div>
                <div>
                    <p class="om-mark is-small"><b>Omni</b><i>sense</i></p>
                    <p>{{ '@messages.footer.what'|trans }}</p>
                </div>
            </div>
            <nav aria-label="{{ '@messages.footer.plan'|trans }}">
                <h2>{{ '@messages.footer.plan'|trans }}</h2>
                <ul>
                    <li><a href="{{ path('app_docs') }}">{{ '@messages.nav.docs'|trans }}</a></li>
                    <li><a href="{{ path('app_packages') }}">{{ '@messages.nav.packages'|trans }}</a></li>
                    <li><a href="{{ path('app_news') }}">{{ '@messages.nav.blog'|trans }}</a></li>
                    <li><a href="{{ path('app_search') }}">{{ '@messages.nav.search'|trans }}</a></li>
                    <li><a href="{{ path('app_support') }}">{{ '@messages.nav.support'|trans }}</a></li>
                </ul>
            </nav>
            <div>
                <h2>{{ '@messages.footer.sources'|trans }}</h2>
                <ul>
                    <li><a href="{{ site.githubUrl }}" rel="noopener">GitHub · {{ site.github }}</a></li>
                    <li><a href="https://packagist.org/packages/omnisense/" rel="noopener">Packagist · omnisense</a></li>
                    <li><a href="{{ path('app_news_atom') }}" data-transparent-ignore>{{ '@messages.footer.feed'|trans }} (Atom)</a></li>
                    <li><a href="{{ path('app_news_rss') }}" data-transparent-ignore>{{ '@messages.footer.feed'|trans }} (RSS)</a></li>
                </ul>
            </div>
            <div>
                <h2>{{ '@messages.footer.site'|trans }}</h2>
                <ul>
                    <li><a href="{{ path('app_legal') }}">{{ '@messages.footer.legal'|trans }}</a></li>
                    <li><a href="{{ path('app_privacy') }}">{{ '@messages.footer.privacy'|trans }}</a></li>
                </ul>
            </div>
        </div>
    </div>
</footer>
{% endblock %}
