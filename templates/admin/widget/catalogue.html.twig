{# The state of the catalogue (App\Admin\Widget\CatalogueWidgetType). #}
<div class="analytics-card card app-catalogue">
    <div class="analytics-card-header">
        <h2 class="analytics-card-title">{{ widget.label|trans({}, 'admin') }}</h2>
    </div>
    <div class="app-widget-body">
        <ul class="app-figures">
            <li><strong>{{ counts.packages }}</strong><span>paquets</span></li>
            <li><strong>{{ manuals }}</strong><span>manuels</span></li>
            <li><strong>{{ counts.published }}</strong><span>sur leur registre</span></li>
            <li><strong>{{ counts.unpublished }}</strong><span>absents du registre</span></li>
            <li><strong>{{ followers }}</strong><span>suivis</span></li>
        </ul>
        {% if counts.unknown %}<p class="app-widget-note">{{ counts.unknown }} paquet(s) dont le registre n'a jamais répondu.</p>{% endif %}
        <p class="app-widget-note">{% if synced %}Dépôts lus le {{ synced|format_datetime('medium', 'short') }}.{% else %}Les dépôts n'ont pas encore été lus (<code>app:packages:sync</code>).{% endif %} Recherche : {{ engine == 'typesense' ? 'Typesense' : 'index des pages' }}.</p>
        <p class="app-widget-note"><a href="{{ path('admin_crud_packages_index') }}">Paquets</a> · <a href="{{ path('admin_manuals') }}">Manuels</a></p>
    </div>
</div>
<style>
    .app-widget-body { padding: 1rem 1.25rem 1.1rem; }
    .app-figures { display: flex; flex-wrap: wrap; gap: .75rem 1.75rem; margin: 0 0 .75rem; padding: 0; list-style: none; }
    .app-figures li { display: grid; }
    .app-figures strong { font-size: 1.7rem; line-height: 1.1; }
    .app-figures span, .app-widget-note { font-size: .82rem; color: var(--admin-muted); }
    .app-widget-note { margin: .3rem 0 0; }
    .app-widget-list { margin: 0; padding: 0; list-style: none; columns: 2; font-size: .86rem; }
</style>
