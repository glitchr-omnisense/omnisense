{# The language - the same page in the other language, when it exists - and light / dark: at the right of the title block. #}
<div class="om-tools">
    {% set current = app.request.locale|lang %}
    {% for other, href in page_alternates(alternate_locales ?? null)|filter((h, l) => l != current) %}
    <a class="om-tool" href="{{ href }}" hreflang="{{ other }}" lang="{{ other }}" aria-label="{{ '@messages.nav.languages'|trans }}: {{ other|upper }}">{{ other|upper }}</a>
    {% endfor %}
    <button type="button" class="om-tool" data-controller="theme" data-action="theme#toggle" aria-label="{{ '@messages.nav.theme'|trans }}" title="{{ '@messages.nav.theme'|trans }}">
        <i class="fa-solid fa-moon om-when-light" aria-hidden="true"></i>
        <i class="fa-solid fa-sun om-when-dark" aria-hidden="true"></i>
    </button>
</div>
