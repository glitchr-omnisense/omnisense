{# A package's state as its own README says it: verified against the real service, in part, or not. #}
{% if package.constraint %}<a class="om-fact is-yes" href="{{ package.registryUrl }}" rel="noopener">{{ package.registry }} · {{ package.constraint }}</a>{% endif %}
{% if package.verification.value != 'unstated' %}
    <span class="om-fact is-{{ package.verification.value }}" title="{{ package.verificationNote }}">{{ ('@messages.state.' ~ package.verification.value)|trans }}</span>
{% endif %}
