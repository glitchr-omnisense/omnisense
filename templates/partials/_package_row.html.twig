{#
 # A package as a row of a family's list: its name, what it is, whether its
 # README says it was tried for real, its manual. short: print the name
 # without its vendor.
 #}
<li class="om-row">
    <a class="om-row-name" href="{{ path('app_package', {vendor: package.vendor, name: package.shortName}) }}">
        {%- if short|default(false) %}<span>{{ package.vendor }}/</span>{{ package.shortName }}{% else %}{{ package.name }}{% endif -%}
    </a>
    <p class="om-row-text">{{ package.description ?? '@messages.catalogue.no_description'|trans }}</p>
    <p class="om-row-facts">
        {% include 'partials/_states.html.twig' with {package: package} %}
        {% if package.documented %}<a class="om-fact is-link" href="{{ path('app_manual_root', {key: package.key}) }}">{{ '@messages.catalogue.manual'|trans }}</a>{% endif %}
    </p>
</li>
