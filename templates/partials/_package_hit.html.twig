{#
 # A package as a row of the search: its name, what it is, its family, its
 # development branch, "not tested live" when its README says so, its links.
 # The data-* attributes are what search_controller.js narrows the rows by
 # (App\Catalogue\PackageSearch writes the same haystack it searches).
 #}
<li class="om-hit" data-name="{{ package.name|lower }}" data-short="{{ package.shortName|lower }}" data-text="{{ search_haystack(package) }}" data-family="{{ package.family }}" data-kind="{{ package.tier.kind }}" data-order="{{ order }}">
    <div class="om-hit-head">
        <a class="om-hit-name" href="{{ doc_url(package) }}">{{ package.name|omni_mark }}</a>
        <span class="om-kind is-{{ package.tier.kind }}">{{ ('@messages.kind.' ~ package.tier.kind ~ '_one')|trans }}</span>
        {% if package.family and package.tier.kind not in ['core', 'family'] and package.family in family_pages %}<a class="om-hit-family" href="{{ family_url(package.family) }}">{{ package.family }}</a>{% endif %}
        {% if package.constraint %}<code class="om-hit-version" title="{{ '@messages.search.version_title'|trans }}">{{ package.constraint }}</code>{% endif %}
        {% if package.verification.value == 'unverified' %}<span class="om-fact is-unverified" title="{{ package.verificationNote }}">{{ '@messages.search.untested'|trans }}</span>{% elseif package.verification.value == 'partial' %}<span class="om-fact is-partial" title="{{ package.verificationNote }}">{{ '@messages.search.partly_tested'|trans }}</span>{% endif %}
    </div>
    <p class="om-hit-text">{{ package.description ?? '@messages.catalogue.no_description'|trans }}</p>
    <p class="om-hit-links">
        <a href="{{ package.registryUrl }}" rel="noopener">{{ package.registry }}</a>
        {% if package.repositoryUrl %}<a href="{{ package.repositoryUrl }}" rel="noopener">GitHub</a>{% endif %}
        {% if package.documented %}<a href="{{ path('app_manual_root', {key: package.key}) }}">{{ '@messages.search.docs'|trans }}</a>{% endif %}
    </p>
</li>
