{#
 # Which frameworks the packages run in: what is true today (the families run
 # in plain PHP, proved by each family's BareTest; omnibase and its components
 # are Symfony bundles) and what will be (omnibase made agnostic, its framework
 # parts in bridges; plan 0, rule 13) - no date promised.
 # letter: the section's mark on the home page ("E").
 # bridges: where the bridges are described already (the home page's
 # #bridges): then they are not listed again here, only pointed at.
 #}
<header class="om-head">
    <p class="om-cote">{% if letter is defined %}{{ letter }} — {% endif %}{{ '@messages.compat.eyebrow'|trans }}</p>
    <h2>{{ '@messages.compat.title'|trans }}</h2>
    <p class="om-lead">{{ '@messages.compat.lead'|trans }}</p>
</header>
<div class="om-compat">
    <div class="om-compat-col is-now">
        <h3><span class="om-fact is-verified">{{ '@messages.compat.now'|trans }}</span> {{ '@messages.compat.families_title'|trans }}</h3>
        <p>{{ '@messages.compat.families_text'|trans|raw }}</p>
        <pre class="om-code"><code>use Omnitrade\PayPal\PayPalGatewayFactory;
use Omnitrade\Registry;
use Symfony\Component\HttpClient\HttpClient;

// No container, no kernel: the registry is built by hand.
$registry = new Registry([new PayPalGatewayFactory(HttpClient::create())], [
    'paypal' =&gt; ['factory' =&gt; 'paypal', 'options' =&gt; ['client_id' =&gt; $id, 'secret' =&gt; $secret]],
]);
$gateway = $registry-&gt;get('paypal');</code></pre>
        <p class="om-note">{{ '@messages.compat.families_proof'|trans|raw }}</p>
    </div>
    <div class="om-compat-col is-now">
        <h3><span class="om-fact is-partial">{{ '@messages.compat.now'|trans }}</span> {{ '@messages.compat.omnibase_title'|trans }}</h3>
        <p>{{ '@messages.compat.omnibase_text'|trans|raw }}</p>
    </div>
    <div class="om-compat-col is-later">
        <h3><span class="om-fact is-unstated">{{ '@messages.compat.later'|trans }}</span> {{ '@messages.compat.agnostic_title'|trans }}</h3>
        <p>{{ '@messages.compat.agnostic_text'|trans|raw }}</p>
        {% if bridges is defined %}
        <p>{{ '@messages.compat.bridges_below'|trans({url: bridges})|raw }}</p>
        {% else %}
        <ul class="om-compat-bridges">
            <li><code>omnibridge/symfony</code><span>{{ '@messages.compat.bridge_symfony'|trans }}</span></li>
            <li><code>omnibridge/doctrine</code><span>{{ '@messages.compat.bridge_doctrine'|trans }}</span></li>
            <li><code>omnibridge/twig</code><span>{{ '@messages.compat.bridge_twig'|trans }}</span></li>
            <li><code>omnibridge/composer</code><span>{{ '@messages.compat.bridge_composer'|trans }}</span></li>
            <li><code>omnibridge/laravel</code><span>{{ '@messages.compat.bridge_laravel'|trans }}</span></li>
        </ul>
        {% endif %}
        <p class="om-note">{{ '@messages.compat.read_more'|trans({url: path('app_guide', {slug: 'compatibility'})})|raw }}</p>
    </div>
</div>
