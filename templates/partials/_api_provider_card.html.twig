{#
 # A provider as a card of /apis: its name and package, its family, its
 # status, and its usage policy - its package's policy.json, or what
 # config/apis.yaml typed for a provider with no package yet: access, limits,
 # commercial use, caching, storage and redistribution, the credit, who
 # declared it and when it was verified, the terms (partials/_api_policy) -
 # "not declared yet" when there is none. The data-* attributes are what
 # apis_controller.js filters by.
 #}
{% import 'partials/_api_policy.html.twig' as p %}
{% set locale = app.request.locale|lang %}
{% set policy = provider.policy %}
<li class="om-card is-provider is-{{ provider.status.value }}"
    data-kind="provider" data-family="{{ provider.family }}" data-status="{{ provider.status.value }}"
    data-capabilities="{{ provider.capabilities|join(' ') }}" data-auth="{{ provider.auth }}" data-commercial="{{ provider.commercial }}"
    data-help="{{ provider.helpWanted ? 1 : 0 }}" data-text="{{ api_haystack(provider, locale) }}">
    <header class="om-card-head">
        <h3 class="om-card-name">{{ provider.name }}</h3>
        <span class="om-status is-{{ provider.status.value }}">{{ ('@messages.apis.status.' ~ provider.status.value)|trans }}</span>
    </header>
    {% if provider.successor %}
    <p class="om-card-package"><code>{{ provider.successor }}</code> · <a href="#card-{{ provider.family }}">{{ provider.family }}</a><br><span class="om-card-was">{{ '@messages.apis.was'|trans({package: provider.package}) }}</span></p>
    {% else %}
    <p class="om-card-package"><code>{{ provider.package }}</code> · <a href="#card-{{ provider.family }}">{{ provider.family }}</a></p>
    {% endif %}
    {% if provider.description %}<p class="om-card-text">{{ provider.description }}</p>{% endif %}
    {% if policy %}
    <dl class="om-policy">
        <div><dt>{{ '@messages.apis.policy.auth'|trans }}</dt><dd>{{ p.access(policy) }}</dd></div>
        <div><dt>{{ '@messages.apis.policy.limits'|trans }}</dt><dd>{{ p.limits(policy, 3, path('app_api_policies') ~ '#policy-' ~ provider.package|replace({'/': '-'})) }}{{ p.plans(policy) }}</dd></div>
        <div><dt>{{ '@messages.apis.policy.commercial'|trans }}</dt><dd>{{ p.permission(policy.commercial) }}</dd></div>
        <div><dt>{{ '@messages.apis.policy.reuse'|trans }}</dt><dd>{{ p.reuse(policy) }}</dd></div>
        <div><dt>{{ '@messages.apis.policy.attribution'|trans }}</dt><dd>{{ p.attribution(policy) }}</dd></div>
        <div><dt>{{ '@messages.apis.policy.declared'|trans }}</dt><dd>{{ p.declared(policy) }}</dd></div>
    </dl>
    {% if policy.note(locale) %}<p class="om-card-note">{{ policy.note(locale) }}</p>{% endif %}
    {% else %}
    <p class="om-card-note">{{ '@messages.apis.policy.undeclared'|trans }}</p>
    {% endif %}
    <p class="om-card-foot">
        <span class="om-card-tags-inline">{% for capability in provider.capabilities %}<span>{{ api_label(capability, locale) }}</span>{% endfor %}</span>
        {% if provider.helpWanted %}<span class="om-fact is-new">{{ '@messages.apis.help_wanted'|trans }}</span>{% endif %}
    </p>
    <p class="om-card-links">
        {% if provider.released %}<a href="{{ doc_url(provider.released) }}">{{ '@messages.apis.package'|trans }}</a>{% endif %}
        {% if provider.repositoryUrl %}<a href="{{ provider.repositoryUrl }}" rel="noopener">GitHub</a>{% endif %}
        {% if policy %}{{ p.sources(policy) }}{% endif %}
        {% if provider.helpWanted %}<a href="{{ api_issue(stars.repository, templates.provider, '[' ~ provider.package ~ '] ') }}" rel="noopener">{{ '@messages.apis.maintain'|trans }}</a>
        {% elseif provider.status.value == 'available' %}<a href="{{ api_issue(stars.repository, templates.company, '[' ~ provider.package ~ '] ') }}" rel="noopener">{{ '@messages.apis.review'|trans }}</a>{% endif %}
    </p>
</li>
